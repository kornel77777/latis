{
  "name": "latis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @latis/desktop dev",
    "build": "pnpm --filter @latis/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit && node scripts/test-native.mjs",
    "e2e": "pnpm --filter @latis/desktop e2e",
    "test:unit": "vitest run --project unit",
    "test:native": "node scripts/test-native.mjs",
    "format:check": "prettier --check .",
    "package": "pnpm --filter @latis/desktop package",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
